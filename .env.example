# Render PostgreSQL: use a JDBC URL, not the postgres:// connection string.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Optional full Redis URL. Leave the variable UNSET when using host/port below.
# SPRING_DATA_REDIS_URL=rediss://username:password@your-redis-host:6379
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Only set this optional full checkout URL to override the Render URL:
# MOCK_PAYMENT_CHECKOUT_URL=https://your-custom-domain/mock-payment.html
MOCK_PAYMENT_ENABLED=true
MOCK_EXTERNAL_TRANSFER_ENABLED=true
JWT_SECRET=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FIREBASE_PROJECT_ID=
FCM_ENABLED=false
# If enabling FCM on Render, upload the JSON as a secret file and set its path.
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
